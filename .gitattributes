# Normalize text files to LF in the repository.
* text=auto

# Shell scripts must keep LF endings to run on macOS/Linux.
*.sh text eol=lf
*.command text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.sqlite binary
*.zip binary
*.tgz binary
